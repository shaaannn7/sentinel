# SENTINEL Environment Configuration
# Copy this file to .env and configure production secrets outside source control.

DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://:change_me@redis:6379/0

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MOCK_ENABLED=false

THREAT_INTEL_PROVIDER=mock
THREAT_INTEL_API_KEY=
GEOLOCATION_PROVIDER=mock
GEOLOCATION_API_KEY=

STORE_RAW_EMAIL=true
MAX_UPLOAD_SIZE=10485760
DEMO_MODE=true
UPLOAD_DIR=/tmp/sentinel/uploads
CORS_ORIGINS=http://localhost:3000
API_AUTH_KEY=
ADMIN_API_KEY=
ANALYST_API_KEY=
VIEWER_API_KEY=
AUTH_ENFORCE=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_UPLOAD=15/minute
RATE_LIMIT_EXPENSIVE=6/minute
