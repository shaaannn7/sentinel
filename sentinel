#!/usr/bin/env bash
# SENTINEL launcher.
#
# Supported entry points:
#   ./sentinel <command>       Run the terminal interface.
#   ./sentinel cli <command>   Explicit terminal alias.

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
CLI=(env PYTHONPATH="$DIR/apps/api" python3 "$DIR/apps/api/cli.py")

run_cli() {
  exec "${CLI[@]}" "$@"
}

case "${1:-}" in
  cli)
    shift
    run_cli "$@"
    ;;
  help|--help|-h)
    cat <<'EOF'
SENTINEL — Terminal Email Threat Detection & Forensics

Everything happens in your terminal:
  ./sentinel                    Open the interactive command center
  ./sentinel status             Show the SOC command dashboard
  ./sentinel analyze file.eml   Analyze an email artifact
  ./sentinel watch ./dropbox    Monitor a folder for new .eml files

Examples:
  ./sentinel status --animate
  ./sentinel analyze path/to/message.eml --ai
  ./sentinel list
EOF
    ;;
  *)
    run_cli "$@"
    ;;
esac
